# Legal Metrology Compliance Platform Environment Configuration
PROJECT_NAME="Legal Metrology Packaged Commodity Compliance Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=dev-insecure-legal-metrology-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for instant zero-dependency dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./legal_metrology.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_metrology

# Storage Settings
STORAGE_DIR=./storage

# Perception Engines
OCR_PROVIDER=mock
